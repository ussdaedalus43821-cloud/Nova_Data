# nova_data.nova - Nova_Data: a spending report from a CSV file of financial transactions.
#
#   python3 novalang/novalang.py nova_data.nova TRANSACTIONS.CSV
#
# The whole tool is this one NovaLang program: no Python host, no regular expressions, and the only imports are
# NovaLang's own standard modules (std:csv, std:decimal, std:files and std:format). It reads
# Date,Description,Amount,Category records, totals them per category, finds the largest single charge and prints
# a terminal report with dollar amounts and bar charts.
#
# The design rule is: MONEY IS NEVER A FLOAT. An amount like "1,250.50" is read into an exact decimal with
# std:decimal (NovaLang's own library: NovaLang has no decimal type, `round` is half-to-even and `str(5.0)` is
# "5", docs/GAPS.md G-043, G-044, and G-008 in Nova_Stats), every sum is a decimal, and the only place an amount
# becomes text is `money()` below. Before the library existed this file read amounts by hand into integer cents
# and divided with its own half-up routine; those helpers are gone, and the report is byte for byte the same
# (tests/test_data.py). A naive float sum is still kept on the side, only so the report can show how far it
# drifts from the exact one.
#
# Sign convention (a credit-card export): a charge is positive, a refund or credit is negative. "Spent" is the
# net of both.
#
# It reads the file with std:files (in 64 KiB pieces, so a file over the 1,000,000-character string limit of the
# `restricted` profile is no longer refused, G-036), and needs only `files.read` for that, `process` (for args and exit)
# and, if it is there, `clock` (for the timings). Under the `restricted` profile that is `--allow-read DIR
# --allow-process`: a standard module needs no `import` grant, only the capabilities it declares
# (docs/spec/08-modules.md [mod.std] in NovaLang).

import "std:csv" as csv
import "std:decimal" as dec
import "std:files" as files
import "std:format" as fmt


let DIGITS = "0123456789"
let LAST_DAY = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
let EIGHTHS = ["", "▏", "▎", "▍", "▌", "▋", "▊", "▉"]
let BAR_WIDTH = 20
let MAX_CONTINUATION = 8
let ZERO = dec.parse("0.00")

# ---- text helpers the standard library does not have (each points at its entry in docs/GAPS.md) ----

# One or more ASCII digits and nothing else. A loop over the characters is exact but slow (about 6 microseconds a
# character on the VM), so the text is first checked at both ends and for a "." and then handed to num(): given
# those guards, num() accepts only plain digits (probed in tests/test_units.py). num() alone is too loose
# (" 7", "+5", "1.5" all pass: G-039 in Nova_Log), and there is no isdigit.
def all_digits(text) {
    let n = len(text)
    if n == 0 or not (text[0] in DIGITS) or not (text[n - 1] in DIGITS) or "." in text {
        return false
    }
    if n <= 2 {
        return n == 1 or text[1] in DIGITS
    }
    try {
        num(text)
        return true
    } catch e {
        return false
    }
}

# A non-negative whole number with thousands separators (G-007 in Nova_Stats): std:format does it.
def group_digits(n) {
    return fmt.grouped(str(n), ",")
}

# An amount (a decimal with two places) to "$1,250.50" / "-$45.10".
def money(amount) {
    let sign = ""
    if dec.sign(amount) < 0 {
        sign = "-"
    }
    return sign + "$" + fmt.grouped(dec.to_string(dec.absolute(amount)), ",")
}

# part / whole as a percentage with one decimal (half away from zero), "-" when whole is not positive.
def percent(part, whole) {
    if dec.sign(whole) <= 0 {
        return "-"
    }
    return dec.to_string(dec.div(dec.mul(part, dec.from_int(100)), whole, 1, "half_up")) + "%"
}

# A bar in eighths of a block, so 20 characters give 160 steps, not 20.
def bar(value, biggest) {
    if dec.sign(value) <= 0 or dec.sign(biggest) <= 0 {
        return ""
    }
    let eighths = dec.to_int(dec.div(dec.mul(value, dec.from_int(BAR_WIDTH * 8)), biggest, 0, "half_up"), "half_up")
    if eighths < 1 {
        eighths = 1
    }
    return "█" * (eighths // 8) + EIGHTHS[eighths % 8]
}

# Seconds with two decimals, from integers (G-008): floor(x + 0.5) is a half-up round of a positive number.
def seconds_text(x) {
    let hundredths = floor(x * 100 + 0.5)
    return str(hundredths // 100) + "." + fmt.pad_zero(hundredths % 100, 2) + " s"
}

# "1 record", "2 records". There is no conditional expression and `and`/`or` give only true or false (G-049),
# so even a plural takes an `if`.
def counted(n, one, many) {
    if n == 1 {
        return group_digits(n) + " " + one
    }
    return group_digits(n) + " " + many
}

# A description may hold a newline (a quoted field spanning lines); the report is one line per item.
# replace_all() would do it, but it belongs to the `regex` capability and does not exist in a plain restricted
# run (G-050), so it is split and joined instead.
def one_line(text) {
    return join(split(join(split(trim(text), "\r"), " "), "\n"), " ")
}

def fit(text, width) {
    if len(text) <= width {
        return text
    }
    return text[:width - 1] + "…"
}

# ---- validation by hand (num() throws on bad text and accepts more than digits: G-039 in Nova_Log) ----

def is_leap(year) {
    return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
}

# "YYYY-MM-DD", a real calendar day. No date type, no parser (G-046).
def is_date(text) {
    if len(text) != 10 or text[4] != "-" or text[7] != "-" {
        return false
    }
    let y = text[:4]
    let m = text[5:7]
    let d = text[8:]
    if not (all_digits(y) and all_digits(m) and all_digits(d)) {
        return false
    }
    let year = num(y)
    let month = num(m)
    let day = num(d)
    if year < 1 or month < 1 or month > 12 or day < 1 {
        return false
    }
    let last = LAST_DAY[month - 1]
    if month == 2 and is_leap(year) {
        last = 29
    }
    return day <= last
}

# Money text to an exact decimal with two places: [amount, ""] or [ZERO, "why not"]. Accepts 12, 12.5, 12.50,
# -12.50, +12.50, $12.50, -$12.50, (12.50) for a negative, and 1,250.50 with correctly placed thousands
# separators. More than two decimals is refused, not rounded: a fraction of a cent is a data error.
# The syntax is checked here (the report says why a row is refused); std:decimal does the number.
def parse_amount(raw) {
    # The fast path: 1 to 9 digits, a point, two digits. That is nearly every row, and it skips the general path.
    let size = len(raw)
    if size >= 4 and size <= 12 and raw[size - 3] == "." {
        let w = raw[:size - 3]
        let f = raw[size - 2:]
        if all_digits(w) and all_digits(f) {
            return [dec.parse(raw), ""]
        }
    }
    let text = trim(raw)
    if text == "" {
        return [ZERO, "amount is empty"]
    }
    let negative = false
    if len(text) >= 3 and text[0] == "(" and text[len(text) - 1] == ")" {
        negative = true
        text = trim(text[1:len(text) - 1])
    }
    if text[:1] == "-" or text[:1] == "+" {
        if text[0] == "-" {
            negative = true
        }
        text = text[1:]
    }
    if text[:1] == "$" {
        text = text[1:]
    }
    let parts = split(text, ".")
    if len(parts) > 2 {
        return [ZERO, "amount has more than one decimal point: " + raw]
    }
    let whole = parts[0]
    let frac = ""
    if len(parts) == 2 {
        frac = parts[1]
        if len(frac) == 0 {
            return [ZERO, "amount has a decimal point but no cents: " + raw]
        }
    }
    if len(frac) > 2 {
        return [ZERO, "amount has a fraction of a cent: " + raw]
    }
    if frac != "" and not all_digits(frac) {
        return [ZERO, "amount is not money: " + raw]
    }
    if "," in whole {
        let groups = split(whole, ",")
        for g in groups {
            if not all_digits(g) {
                return [ZERO, "amount is not money: " + raw]
            }
        }
        if len(groups[0]) > 3 {
            return [ZERO, "misplaced thousands separator: " + raw]
        }
        for i = 1 to len(groups) - 1 {
            if len(groups[i]) != 3 {
                return [ZERO, "misplaced thousands separator: " + raw]
            }
        }
        whole = join(groups, "")
    }
    if not all_digits(whole) or len(whole) > 12 {
        return [ZERO, "amount is not money: " + raw]
    }
    let amount = dec.quantize(dec.parse(whole + "." + frac), 2, "down")
    if negative {
        amount = dec.negate(amount)
    }
    return [amount, ""]
}

# ---- CSV: std:csv reads the fields; this file only decides where a record ends ----

let BOM = "﻿"

# True when a line leaves a quoted field open: an odd number of quote characters. This is the record framing
# (how many of the lines split_lines() made belong to one record, G-047), not field parsing: it is what lets one
# stray quote cost one row instead of the rest of the file.
def open_quote(line) {
    return len(split(line, "\"")) % 2 == 0
}

# One record into fields: [fields, ""] or [[], "why not"]. std:csv (RFC 4180) does the reading; a record it
# refuses becomes a rejected row with a short reason rather than stopping the whole report.
#  - csv.parse_with() drops one byte order mark at the start of its text, so a record that itself starts with one
#    gets a second in front: the first is dropped and the record keeps the one it had (it is then not a date).
#  - A record cannot have more fields than characters + 1, so that is the max_fields that never refuses one: a row
#    with too many fields is "expected 4 fields, found N", as it always was, not a library limit.
def read_record(line) {
    let text = line
    if line[:1] == BOM {
        text = BOM + line
    }
    try {
        return [csv.parse_with(text, {max_fields: len(text) + 1})[0], ""]
    } catch e {
        let why = str(e)
        if "never closed" in why {
            return [[], "a quoted field is never closed"]
        }
        if "after the closing quote" in why {
            return [[], "text after a closing quote"]
        }
        if "does not start with one" in why {
            return [[], "a quote in the middle of an unquoted field"]
        }
        throw(why)
    }
}

# ---- the program ----

let argv = args()
if len(argv) < 1 {
    print("usage: nova_data.nova TRANSACTIONS.CSV")
    exit(2)
}
let path = argv[0]

# `monotonic` is a `clock` name: when the capability is not granted the timings are left out (G-029 in Nova_Sort).
let have_clock = true
let started = 0
try {
    started = monotonic()
} catch e {
    have_clock = false
}

# std:files reads the file in 64 KiB pieces, so a log over the 1,000,000-character string limit of the restricted profile
# no longer fails (G-036); the lines are the ones split_lines() makes of the whole text.
let lines = []
try {
    lines = files.lines(path)
} catch e {
    print("nova_data: cannot read " + path + ": " + str(e))
    exit(1)
}
let read_done = started
if have_clock {
    read_done = monotonic()
}
if len(lines) > 0 and lines[0][:1] == BOM {
    lines[0] = lines[0][1:]
}

let col_date = -1
let col_desc = -1
let col_amount = -1
let col_category = -1
let width = 0

let counts = {}
let totals = {}
let records = 0
let valid = 0
let blank = 0
let rejected = 0
let reject_notes = []
let charge_count = 0
let refund_count = 0
let charge_total = ZERO
let refund_total = ZERO
let float_sum = 0.0
let first_date = ""
let last_date = ""
let best_amount = ZERO
let best = []
let worst_amount = ZERO
let worst = []
let header_done = false
let date_ok = {}

let idx = 0
while idx < len(lines) {
    let line = lines[idx]
    let line_no = idx + 1
    idx = idx + 1
    if trim(line) == "" {
        blank = blank + 1
        continue
    }
    # A quoted field may contain a newline, which `split_lines` has already cut: glue the next lines back on while
    # a quote is open, but give up after MAX_CONTINUATION lines so one stray quote cannot swallow the file (G-047).
    if "\"" in line and open_quote(line) {
        let glued = line
        let taken = 0
        let next_idx = idx
        while open_quote(glued) and next_idx < len(lines) and taken < MAX_CONTINUATION {
            glued = glued + "\n" + lines[next_idx]
            next_idx = next_idx + 1
            taken = taken + 1
        }
        if not open_quote(glued) {
            line = glued
            idx = next_idx
        }
    }
    let parsed = read_record(line)
    let fields = parsed[0]

    if not header_done {
        header_done = true
        if parsed[1] != "" {
            print("nova_data: " + path + ": the header line is not valid CSV: " + parsed[1])
            exit(1)
        }
        width = len(fields)
        for c = 0 to width - 1 {
            let name = lower(trim(fields[c]))
            if name == "date" {
                col_date = c
            } else if name == "description" {
                col_desc = c
            } else if name == "amount" {
                col_amount = c
            } else if name == "category" {
                col_category = c
            }
        }
        if col_date < 0 or col_desc < 0 or col_amount < 0 or col_category < 0 {
            print("nova_data: " + path + ": the header must name Date, Description, Amount and Category (found: " + join(fields, ",") + ")")
            exit(1)
        }
        continue
    }

    records = records + 1
    let why = parsed[1]
    let amount = ZERO
    if why == "" and len(fields) != width {
        why = "expected " + str(width) + " fields, found " + str(len(fields))
    }
    if why == "" {
        let date = trim(fields[col_date])
        # a file has a few hundred distinct dates and thousands of rows, so each date is checked once
        if not (date in date_ok) {
            date_ok[date] = is_date(date)
        }
        if not date_ok[date] {
            why = "not a valid date (YYYY-MM-DD): " + date
        } else {
            let money_parsed = parse_amount(fields[col_amount])
            amount = money_parsed[0]
            why = money_parsed[1]
        }
    }
    if why != "" {
        rejected = rejected + 1
        if len(reject_notes) < 5 {
            reject_notes = reject_notes + ["line " + group_digits(line_no) + ": " + why]
        }
        continue
    }

    valid = valid + 1
    let date = trim(fields[col_date])
    let category = trim(fields[col_category])
    if category == "" {
        category = "Uncategorized"
    }
    if first_date == "" or date < first_date {
        first_date = date
    }
    if last_date == "" or date > last_date {
        last_date = date
    }
    if category in counts {
        counts[category] = counts[category] + 1
        totals[category] = dec.add(totals[category], amount)
    } else {
        counts[category] = 1
        totals[category] = amount
    }
    if dec.sign(amount) >= 0 {
        charge_count = charge_count + 1
        charge_total = dec.add(charge_total, amount)
        # strictly greater: on a tie the earliest record in the file is the one reported
        if dec.cmp(amount, best_amount) > 0 {
            best_amount = amount
            best = [date, one_line(fields[col_desc]), category, line_no]
        }
    } else {
        refund_count = refund_count + 1
        refund_total = dec.add(refund_total, amount)
        if dec.cmp(amount, worst_amount) < 0 {
            worst_amount = amount
            worst = [date, one_line(fields[col_desc]), category, line_no]
        }
    }
    # the naive way, kept only to be compared with the exact total
    float_sum = float_sum + dec.to_float(amount)
}
let parse_done = read_done
if have_clock {
    parse_done = monotonic()
}
if not header_done {
    print("nova_data: " + path + ": the file has no header line (it is empty or all blank)")
    exit(1)
}

# ---- the report ----

let grand = dec.add(charge_total, refund_total)

# Biggest total first, then alphabetical: sort the names alphabetically, then by total, descending. sorted() with a
# key is stable, so names with the same total stay in alphabetical order.
def total_in_cents(name) {
    return dec.to_int(dec.mul(totals[name], dec.from_int(100)), "down")
}
let names = sorted(sorted(keys(counts)), total_in_cents, true)

# ---- the layout: every column is as wide as its widest cell, so nothing collides whatever the amounts are ----

def widest(cells, least) {
    let w = least
    for cell in cells {
        if len(cell) > w {
            w = len(cell)
        }
    }
    return w
}

let name_width = 8
let biggest = ZERO
let cell_name = []
let cell_n = []
let cell_total = []
let cell_avg = []
let cell_share = []
let cell_bar = []
let rule_len = 78
let w_n = 4
let w_total = 5
let w_avg = 7
let w_share = 5
let foot_avg = ""
if valid > 0 {
    for n in names {
        if len(n) > name_width {
            name_width = len(n)
        }
        if dec.cmp(totals[n], biggest) > 0 {
            biggest = totals[n]
        }
    }
    if name_width > 16 {
        name_width = 16
    }
    for n in names {
        cell_name = cell_name + [pad(fit(n, name_width), name_width)]
        cell_n = cell_n + [group_digits(counts[n])]
        cell_total = cell_total + [money(totals[n])]
        cell_avg = cell_avg + [money(dec.div(totals[n], dec.from_int(counts[n]), 2, "half_up"))]
        cell_share = cell_share + [percent(totals[n], grand)]
        cell_bar = cell_bar + [bar(totals[n], biggest)]
    }
    foot_avg = money(dec.div(grand, dec.from_int(valid), 2, "half_up"))
    w_n = widest(cell_n + [group_digits(valid)], 4)
    w_total = widest(cell_total + [money(grand)], 5)
    w_avg = widest(cell_avg + [foot_avg], 7)
    w_share = widest(cell_share + ["100.0%"], 5)
    # two spaces of margin, the name, then each column with two spaces in front, then the bar
    let table_width = 2 + name_width + (w_n + 2) + (w_total + 2) + (w_avg + 2) + (w_share + 2) + 2 + BAR_WIDTH
    if table_width > rule_len {
        rule_len = table_width
    }
}
let rule = "━" * rule_len
let thin = "─" * rule_len
print("")
print("  NOVA_DATA  ·  " + path)
print("  " + rule)
let summary = "  " + counted(records, "record", "records") + ": " + group_digits(valid) + " read, " + group_digits(rejected) + " rejected"
if blank > 0 {
    summary = summary + ", " + counted(blank, "blank line", "blank lines") + " skipped"
}
print(summary)
if valid > 0 {
    print("  " + first_date + "  to  " + last_date + "   ·   " + counted(len(names), "category", "categories"))
}
if valid == 0 {
    print("")
    print("  Nothing to report: no valid transactions.")
}

if valid > 0 {
    print("")
    print("  SPENDING BY CATEGORY  (net of refunds)")
    print("  " + thin)
    let head = "  " + pad("Category", name_width) + pad_left("Txns", w_n + 2) + pad_left("Total", w_total + 2) + pad_left("Average", w_avg + 2)
    head = head + pad_left("Share", w_share + 2) + "  Bar"
    print(head)
    for i = 0 to len(cell_name) - 1 {
        let row = "  " + cell_name[i] + pad_left(cell_n[i], w_n + 2) + pad_left(cell_total[i], w_total + 2)
        row = row + pad_left(cell_avg[i], w_avg + 2) + pad_left(cell_share[i], w_share + 2) + "  " + cell_bar[i]
        print(row)
    }
    print("  " + thin)
    let foot = "  " + pad("TOTAL", name_width) + pad_left(group_digits(valid), w_n + 2) + pad_left(money(grand), w_total + 2)
    foot = foot + pad_left(foot_avg, w_avg + 2) + pad_left("100.0%", w_share + 2)
    print(foot)
    print("")
    let w_money = widest([money(charge_total), money(refund_total)], 10)
    print("  " + pad("Charges", 9) + pad_left(money(charge_total), w_money) + "   in " + counted(charge_count, "transaction", "transactions"))
    print("  " + pad("Refunds", 9) + pad_left(money(refund_total), w_money) + "   in " + counted(refund_count, "transaction", "transactions"))

    print("")
    print("  LARGEST SINGLE TRANSACTION")
    print("  " + thin)
    let w_card = 11
    if len(best) > 0 {
        w_card = widest([money(best_amount)], w_card)
    }
    if len(worst) > 0 {
        w_card = widest([money(worst_amount)], w_card)
    }
    let indent = " " * (2 + 8 + w_card + 3)
    if len(best) > 0 {
        print("  " + pad("Charge", 8) + pad_left(money(best_amount), w_card) + "   " + fit(best[1], 44))
        print(indent + best[2] + "  ·  " + best[0] + "  ·  line " + group_digits(best[3]))
    } else {
        print("  (no charges)")
    }
    if len(worst) > 0 {
        print("  " + pad("Refund", 8) + pad_left(money(worst_amount), w_card) + "   " + fit(worst[1], 44))
        print(indent + worst[2] + "  ·  " + worst[0] + "  ·  line " + group_digits(worst[3]))
    }

    # The float sum, to show what exact decimals avoid. Fixed-point text is built from integers (G-008 in
    # Nova_Stats): str() of a small float switches to exponent form ("4.8e-08", G-048), which num() cannot read
    # back (G-039 in Nova_Log).
    let drift_nano = floor(abs(float_sum - dec.to_float(grand)) * 1000000000 + 0.5)
    let drift_frac = str(drift_nano % 1000000000)
    let drift = "$" + group_digits(drift_nano // 1000000000) + "." + "0" * (9 - len(drift_frac)) + drift_frac
    print("")
    print("  PRECISION CHECK")
    print("  " + thin)
    print("  " + pad("exact sum (integer cents)", 30) + money(grand))
    print("  " + pad("naive float sum, via str()", 30) + str(float_sum))
    print("  " + pad("float error", 30) + drift + " after " + counted(valid, "addition", "additions"))
}
if rejected > 0 {
    print("")
    print("  REJECTED RECORDS  (first " + str(len(reject_notes)) + " of " + group_digits(rejected) + ")")
    print("  " + thin)
    for note in reject_notes {
        print("  " + note)
    }
}
if have_clock {
    print("")
    let timing = "  read " + seconds_text(read_done - started) + ", parse " + seconds_text(parse_done - read_done)
    timing = timing + ", " + group_digits(floor(records / max(0.001, parse_done - read_done))) + " records/s"
    print(timing)
}
print("")
